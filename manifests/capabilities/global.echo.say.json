{
  "manifestVersion": "axf/v0",
  "id": "global.echo.say",
  "summary": "Return a message through the built-in echo provider",
  "provider": "echo",
  "adapterType": "internal",
  "executionTarget": {
    "handler": "echo.say"
  },
  "argsSchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string"
      },
      "prefix": {
        "type": "string"
      },
      "await": {
        "type": "object",
        "properties": {
          "descriptor": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "enum": ["axf/awaitable/v1"]
              },
              "kind": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "object"
              },
              "condition": {
                "type": "object"
              }
            },
            "required": ["schemaVersion", "kind", "subject", "condition"],
            "additionalProperties": false
          },
          "deadlineMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 1800000
          }
        },
        "required": ["descriptor", "deadlineMs"],
        "additionalProperties": false
      }
    }
  },
  "outputModes": [
    "text",
    "json"
  ],
  "sideEffects": "none",
  "scope": "global",
  "lifecycleState": "active",
  "defaults": {},
  "policies": [],
  "owner": "module:echo",
  "completion": {
    "mode": "external-awaitable",
    "descriptorSchema": "axf/awaitable/v1",
    "observer": "global.await.external"
  },
  "examples": [
    "axf run echo say --message hello"
  ]
}
